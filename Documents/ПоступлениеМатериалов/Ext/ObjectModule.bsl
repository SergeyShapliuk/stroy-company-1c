Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ЗаявкаНаМатериалы") Тогда
		Возврат;
	КонецЕсли;  
	
	Заявка = ДанныеЗаполнения.ПолучитьОбъект();

	// Не даём даже открыть поступление по несогласованной заявке.
	// Проверка при записи (ОбработкаПроверкиЗаполнения) остаётся как вторая линия.
	Если Заявка.Состояние <> Перечисления.СостоянияЗаявок.Согласована Тогда
		ВызватьИсключение "Заявка " + Строка(ДанныеЗаполнения) + " не согласована (состояние: "
			+ Строка(Заявка.Состояние) + "). Оформить поступление можно только по согласованной заявке.";
	КонецЕсли;

	ДокументОснование = ДанныеЗаполнения;

	Ответственный = Заявка.Ответственный;
	
	Материалы.Очистить();
	
	Для Каждого СтрокаЗаявки Из Заявка.Материалы Цикл
		НоваяСтрока = Материалы.Добавить();
		НоваяСтрока.Материал = СтрокаЗаявки.Материал;
		НоваяСтрока.Количество = СтрокаЗаявки.Количество;
		НоваяСтрока.Цена = СтрокаЗаявки.Цена;
		НоваяСтрока.Сумма = СтрокаЗаявки.Сумма;
	КонецЦикла;
	
КонецПроцедуры              

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Поставщик и Склад проверяет платформа по свойству «Проверка заполнения».
	
	Если Материалы.Количество() = 0 Тогда
		СообщитьОбОшибке("В поступлении нет ни одной строки материалов", "Материалы");
		Отказ = Истина;
	КонецЕсли;
	
	ПроверитьСтрокиТабличнойЧасти(Отказ);
	
	// Пустое основание допустимо: поступление, созданное командой «Создать».
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		СостояниеЗаявки = ДокументОснование.Состояние;
		Если СостояниеЗаявки <> Перечисления.СостоянияЗаявок.Согласована Тогда
			СообщитьОбОшибке("Заявка " + Строка(ДокументОснование) + " не согласована (состояние: "
				+ Строка(СостояниеЗаявки) + "), принимать материалы по ней нельзя", "ДокументОснование");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтрокиТабличнойЧасти(Отказ)
	
	Для Каждого СтрокаМатериала Из Материалы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Материал", "не выбран материал");
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаМатериала.Количество <= 0 Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Количество", "количество должно быть больше нуля");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СообщитьОбОшибкеСтроки(НомерСтроки, ИмяРеквизита, ТекстОшибки)
	
	СообщитьОбОшибке("Строка " + Строка(НомерСтроки) + ": " + ТекстОшибки,
		"Материалы[" + Строка(НомерСтроки - 1) + "]." + ИмяРеквизита);
	
КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстОшибки, Поле)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Проверяем все строки за один проход, чтобы пользователь
	// увидел сразу все ошибки, а не по одной за нажатие
	Для Каждого СтрокаМатериалов Из Материалы Цикл
		
		ПрефиксСтроки = "Строка " + Строка(СтрокаМатериалов.НомерСтроки) + ": ";
		ПутьКСтроке = "Материалы[" + Строка(СтрокаМатериалов.НомерСтроки - 1) + "].";
		
		Если НЕ ЗначениеЗаполнено(СтрокаМатериалов.Материал) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ПрефиксСтроки + "не заполнен материал";
			Сообщение.Поле = ПутьКСтроке + "Материал";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаМатериалов.Количество <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ПрефиксСтроки + "количество должно быть больше нуля";
			Сообщение.Поле = ПутьКСтроке + "Количество";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;     
	
		// Все проверки выполнены, все сообщения выданы.
	// Если операция отклонена, собирать движения незачем.
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Набор движений будет записан после выхода из процедуры
	Движения.ОстаткиМатериалов.Записывать = Истина;
	
	// Одна строка табличной части — одно движение прихода
	Для Каждого СтрокаМатериалов Из Материалы Цикл
		
		Движение = Движения.ОстаткиМатериалов.Добавить();
		
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Материал = СтрокаМатериалов.Материал;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаМатериалов.Количество;
		
	КонецЦикла;
	
КонецПроцедуры
