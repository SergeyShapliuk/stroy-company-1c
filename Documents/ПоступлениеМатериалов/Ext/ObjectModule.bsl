Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ЗаявкаНаМатериалы") Тогда
		Возврат;
	КонецЕсли;  
	
	Заявка = ДанныеЗаполнения.ПолучитьОбъект();

	// Не даём даже открыть поступление по помеченной на удаление или несогласованной заявке.
	// Вторая линия — ОбработкаПроверкиЗаполнения: документ проводимый, поэтому она срабатывает
	// при проведении (не при записи — поступление по такой заявке записать можно).
	Если Заявка.ПометкаУдаления Тогда
		ВызватьИсключение "Заявка " + Строка(ДанныеЗаполнения)
			+ " помечена на удаление. Оформить поступление по ней нельзя.";
	КонецЕсли;

	Если Заявка.Состояние <> Перечисления.СостоянияЗаявок.Согласована Тогда
		ВызватьИсключение "Заявка " + Строка(ДанныеЗаполнения) + " не согласована (состояние: "
			+ Строка(Заявка.Состояние) + "). Оформить поступление можно только по согласованной заявке.";
	КонецЕсли;

	ДокументОснование = ДанныеЗаполнения;

	ОбъектСтроительства = Заявка.ОбъектСтроительства;
	Ответственный = Заявка.Ответственный;
	
	Материалы.Очистить();
	
	Для Каждого СтрокаЗаявки Из Заявка.Материалы Цикл
		НоваяСтрока = Материалы.Добавить();
		НоваяСтрока.Материал = СтрокаЗаявки.Материал;
		НоваяСтрока.Количество = СтрокаЗаявки.Количество;
		НоваяСтрока.Цена = СтрокаЗаявки.Цена;
		НоваяСтрока.Сумма = СтрокаЗаявки.Сумма;
	КонецЦикла;
	
КонецПроцедуры              

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Поставщик и Склад проверяет платформа по свойству «Проверка заполнения».
	
	Если Материалы.Количество() = 0 Тогда
		СообщитьОбОшибке("В поступлении нет ни одной строки материалов", "Материалы");
		Отказ = Истина;
	КонецЕсли;
	
	ПроверитьСтрокиТабличнойЧасти(Отказ);
	
	// Пустое основание допустимо: поступление, созданное командой «Создать».
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		СостояниеЗаявки = ДокументОснование.Состояние;

		// Согласованную заявку могли потом пометить на удаление — состояние при этом не меняется.
		// Одна причина отказа на поле: пометка удаления важнее состояния
		Если ДокументОснование.ПометкаУдаления Тогда
			СообщитьОбОшибке("Заявка " + Строка(ДокументОснование)
				+ " помечена на удаление, принимать материалы по ней нельзя", "ДокументОснование");
			Отказ = Истина;
		ИначеЕсли СостояниеЗаявки <> Перечисления.СостоянияЗаявок.Согласована Тогда
			СообщитьОбОшибке("Заявка " + Строка(ДокументОснование) + " не согласована (состояние: "
				+ Строка(СостояниеЗаявки) + "), принимать материалы по ней нельзя", "ДокументОснование");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтрокиТабличнойЧасти(Отказ)
	
	Для Каждого СтрокаМатериала Из Материалы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Материал", "не выбран материал");
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаМатериала.Количество <= 0 Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Количество", "количество должно быть больше нуля");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СообщитьОбОшибкеСтроки(НомерСтроки, ИмяРеквизита, ТекстОшибки)
	
	// ЧГ=0 — без разделителя тысяч, иначе путь «Материалы[1 000]» не найдёт ячейку;
	// ЧН=0 — чтобы нулевой индекс первой строки не превратился в пустую строку
	СообщитьОбОшибке("Строка " + Формат(НомерСтроки, "ЧГ=0") + ": " + ТекстОшибки,
		"Материалы[" + Формат(НомерСтроки - 1, "ЧН=0; ЧГ=0") + "]." + ИмяРеквизита);
	
КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстОшибки, Поле)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Все проверки — в ОбработкаПроверкиЗаполнения и свойствах «Проверка заполнения».
	// При интерактивном проведении платформа уже выполнила их, повторный вызов ничего не сообщит;
	// при программном (Записать(РежимЗаписиДокумента.Проведение)) — не вызывала, и без этой строки
	// поступление без склада или по несогласованной заявке провелось бы.
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// Набор движений будет записан после выхода из процедуры
	Движения.ОстаткиМатериалов.Записывать = Истина;
	
	// Одна строка табличной части — одно движение прихода
	Для Каждого СтрокаМатериалов Из Материалы Цикл
		
		Движение = Движения.ОстаткиМатериалов.Добавить();
		
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Материал = СтрокаМатериалов.Материал;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаМатериалов.Количество;
		
	КонецЦикла;
	
КонецПроцедуры
