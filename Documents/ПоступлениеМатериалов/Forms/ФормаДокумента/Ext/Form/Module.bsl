&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаМатериала)
	СтрокаМатериала.Сумма = УчебныеФункции.РассчитатьСумму(СтрокаМатериала.Количество, СтрокаМатериала.Цена);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогПоПоступлению()
	ИтогоПоПоступлению = СуммаСтрок(Объект.Материалы);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СуммаСтрок(Материалы)
	Итог = 0;

	Для Каждого СтрокаМатериала Из Материалы Цикл
		Итог = Итог + СтрокаМатериала.Сумма;
	КонецЦикла;

	Возврат Итог;
КонецФункции

&НаСервереБезКонтекста
Функция ЦенаМатериала(Материал, ДатаДокумента)
	МоментЦены = ?(ЗначениеЗаполнено(ДатаДокумента), ДатаДокумента, ТекущаяДата());
	Отбор = Новый Структура("Материал", Материал);
	Ресурсы = РегистрыСведений.ЦеныМатериалов.ПолучитьПоследнее(МоментЦены, Отбор);
	Возврат Ресурсы.Цена;
КонецФункции

&НаКлиенте
Процедура МатериалыМатериалПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;

	Если ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
		СтрокаМатериала.Цена = ЦенаМатериала(СтрокаМатериала.Материал, Объект.Дата);
	Иначе
		СтрокаМатериала.Цена = 0;
	КонецЕсли;

	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоПоступлению();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;
	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоПоступлению();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;
	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоПоступлению();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПослеУдаления(Элемент)
	ПересчитатьИтогПоПоступлению();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// И для записанного документа, и для созданного на основании
	// строки к этому моменту уже заполнены.
	ИтогоПоПоступлению = СуммаСтрок(Объект.Материалы);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммы(Команда)
	Результат = ПересчитатьСуммыНаСервере();

	Если Результат.ВсегоСтрок = 0 Тогда
		Сообщить("В поступлении нет строк — пересчитывать нечего");
		Возврат;
	КонецЕсли;

	ИтогоПоПоступлению = Результат.Итого;

	Если Результат.Изменено = 0 Тогда
		Сообщить("Цены актуальны, изменённых строк нет (проверено строк: " + Строка(Результат.ВсегоСтрок)
			+ "). Итого: " + Строка(Результат.Итого));
	Иначе
		Сообщить("Обновлены цены в " + Строка(Результат.Изменено) + " из " + Строка(Результат.ВсегоСтрок)
			+ " строк. Итого: " + Строка(Результат.Итого));
	КонецЕсли;
КонецПроцедуры

// Один вызов сервера на всю таблицу: цены материалов читаются здесь же,
// на сервере, поэтому число строк на количество обращений с клиента не влияет.
&НаСервере
Функция ПересчитатьСуммыНаСервере()

	Результат = Новый Структура("ВсегоСтрок, Изменено, Итого", 0, 0, 0);

	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл

		Если ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			НоваяЦена = ЦенаМатериала(СтрокаМатериала.Материал, Объект.Дата);
		Иначе
			НоваяЦена = 0;
		КонецЕсли;

		НоваяСумма = УчебныеФункции.РассчитатьСумму(СтрокаМатериала.Количество, НоваяЦена);

		Если НоваяЦена <> СтрокаМатериала.Цена ИЛИ НоваяСумма <> СтрокаМатериала.Сумма Тогда
			СтрокаМатериала.Цена = НоваяЦена;
			СтрокаМатериала.Сумма = НоваяСумма;
			Результат.Изменено = Результат.Изменено + 1;
		КонецЕсли;

		Результат.ВсегоСтрок = Результат.ВсегоСтрок + 1;
		Результат.Итого = Результат.Итого + СтрокаМатериала.Сумма;

	КонецЦикла;

	Если Результат.Изменено > 0 Тогда
		Модифицированность = Истина;
	КонецЕсли;

	Возврат Результат;

КонецФункции
