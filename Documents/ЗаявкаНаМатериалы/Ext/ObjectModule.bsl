Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Материалы.Количество() = 0 Тогда
		СообщитьОбОшибке("В заявке нет ни одной строки материалов", "Материалы");
		Отказ = Истина;
	КонецЕсли;
	
	ПроверитьСтрокиТабличнойЧасти(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(Состояние) Тогда
		Состояние = Перечисления.СостоянияЗаявок.Новая;
	КонецЕсли;

	Если ЗаявкаСогласовывается() И Не ПраваПользователей.МожноСогласовыватьЗаявки() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Согласовывать заявки может только руководитель снабжения";
		Сообщение.Поле = "Состояние";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Истина, если записываемая заявка переходит в состояние «Согласована».
Функция ЗаявкаСогласовывается()

	Если Состояние <> Перечисления.СостоянияЗаявок.Согласована Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоНовый() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ссылка.Состояние <> Перечисления.СостоянияЗаявок.Согласована;

КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	
	// Копия согласованной или отклонённой заявки — это новая заявка.
	Состояние = Перечисления.СостоянияЗаявок.Новая;
	
КонецПроцедуры

Процедура ПроверитьСтрокиТабличнойЧасти(Отказ)
	
	Для Каждого СтрокаМатериала Из Материалы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Материал", "не выбран материал");
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаМатериала.Количество <= 0 Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Количество", "количество должно быть больше нуля");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СообщитьОбОшибкеСтроки(НомерСтроки, ИмяРеквизита, ТекстОшибки)
	
	// ЧГ=0 — без разделителя тысяч, иначе путь «Материалы[1 000]» не найдёт ячейку;
	// ЧН=0 — чтобы нулевой индекс первой строки не превратился в пустую строку
	СообщитьОбОшибке("Строка " + Формат(НомерСтроки, "ЧГ=0") + ": " + ТекстОшибки,
		"Материалы[" + Формат(НомерСтроки - 1, "ЧН=0; ЧГ=0") + "]." + ИмяРеквизита);
	
КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстОшибки, Поле)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = ПараметрыСеанса.ТекущийСотрудник;
	КонецЕсли;

КонецПроцедуры
