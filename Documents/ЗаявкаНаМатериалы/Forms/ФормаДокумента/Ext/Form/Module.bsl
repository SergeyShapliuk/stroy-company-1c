&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаМатериала)
	СтрокаМатериала.Сумма = УчебныеФункции.РассчитатьСумму(СтрокаМатериала.Количество, СтрокаМатериала.Цена);
КонецПроцедуры    

&НаКлиенте
Процедура ПересчитатьИтогПоЗаявке()
	Итог = 0;

	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл
		Итог = Итог + СтрокаМатериала.Сумма;
	КонецЦикла;

	ИтогоПоЗаявке = Итог;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;
	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;
	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЦенаМатериала(Материал, ДатаДокумента)
	МоментЦены = ?(ЗначениеЗаполнено(ДатаДокумента), ДатаДокумента, ТекущаяДата());
	Отбор = Новый Структура("Материал", Материал);
	Ресурсы = РегистрыСведений.ЦеныМатериалов.ПолучитьПоследнее(МоментЦены, Отбор);
	Возврат Ресурсы.Цена;
КонецФункции

&НаКлиенте
Процедура МатериалыМатериалПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;

	Если ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
		СтрокаМатериала.Цена = ЦенаМатериала(СтрокаМатериала.Материал, Объект.Дата);
	Иначе
		СтрокаМатериала.Цена = 0;
	КонецЕсли;

	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПослеУдаления(Элемент)
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЗаявку(Команда)
	Сводка = ПересчитатьЗаявкуНаСервере();

	ИтогоПоЗаявке = Сводка.Итого;

	Сообщить("Строк в заявке: " + Строка(Сводка.ВсегоСтрок) + ", итого: " + Строка(Сводка.Итого));

	Если Сводка.СтрокБезМатериала > 0 Тогда
		Сообщить("Строк без выбранного материала: " + Строка(Сводка.СтрокБезМатериала) + ". Такую заявку записать не получится.");
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Функция ПересчитатьЗаявкуНаСервере()

	Сводка = Новый Структура("ВсегоСтрок, СтрокБезМатериала, Итого", 0, 0, 0);

	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл

		СтрокаМатериала.Сумма = УчебныеФункции.РассчитатьСумму(СтрокаМатериала.Количество, СтрокаМатериала.Цена);

		Сводка.ВсегоСтрок = Сводка.ВсегоСтрок + 1;
		Сводка.Итого = Сводка.Итого + СтрокаМатериала.Сумма;

		Если Не ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			Сводка.СтрокБезМатериала = Сводка.СтрокБезМатериала + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Сводка;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Пустое состояние бывает не только у новой заявки, но и у заявок,
	// записанных до появления реквизита. Их тоже считаем новыми.
	Если НЕ ЗначениеЗаполнено(Объект.Состояние) Тогда
		Объект.Состояние = Перечисления.СостоянияЗаявок.Новая;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Согласовать(Команда)
	Если Объект.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияЗаявок.Новая") Тогда
		ПоказатьПредупреждение(Неопределено, "Согласовать можно только новую заявку. Текущее состояние: " + Строка(Объект.Состояние) + ".");
		Возврат;
	КонецЕсли;

	Если Объект.Материалы.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, "В заявке нет ни одной строки материалов, согласовывать нечего.");
		Возврат;
	КонецЕсли;

	Если НЕ ЗаписатьЕслиИзменена() Тогда
		Возврат;
	КонецЕсли;

	ПричинаОтказа = СогласоватьНаСервере();
	ПоказатьРезультатСменыСостояния(ПричинаОтказа);
КонецПроцедуры

&НаСервере
Функция СогласоватьНаСервере()
	// Заявка уже записана, но могла попасть в базу до появления проверок
	// (заявки прошлых занятий), поэтому перед согласованием проверяем её заново.
	Возврат ЗаписатьСНовымСостоянием(Перечисления.СостоянияЗаявок.Согласована, Истина);
КонецФункции

&НаКлиенте
Процедура Отклонить(Команда)
	Если Объект.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияЗаявок.Новая") Тогда
		ПоказатьПредупреждение(Неопределено, "Отклонить можно только новую заявку. Текущее состояние: " + Строка(Объект.Состояние) + ".");
		Возврат;
	КонецЕсли;

	Если НЕ ЗаписатьЕслиИзменена() Тогда
		Возврат;
	КонецЕсли;

	ПричинаОтказа = ОтклонитьНаСервере();
	ПоказатьРезультатСменыСостояния(ПричинаОтказа);
КонецПроцедуры

&НаСервере
Функция ОтклонитьНаСервере()
	// Отклоняют как раз неудачные заявки, поэтому содержимое не проверяем:
	// меняется только состояние уже записанного документа.
	Возврат ЗаписатьСНовымСостоянием(Перечисления.СостоянияЗаявок.Отклонена, Ложь);
КонецФункции

// Своя команда вместо стандартной «Создать на основании»: стандартная, пока
// форма нового поступления не записана, активирует эту же форму повторно —
// даже для другой заявки. Уникальный ключ заставляет каждый раз открывать
// новую форму, а параметр «Основание» вызывает ОбработкаЗаполнения поступления.
&НаКлиенте
Процедура СоздатьПоступлениеМатериалов(Команда)
	Если НЕ ЗаписатьЕслиИзменена() Тогда
		Возврат;
	КонецЕсли;

	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение(Неопределено, "Заявка помечена на удаление. Оформить поступление по ней нельзя.");
		Возврат;
	КонецЕсли;

	Если Объект.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияЗаявок.Согласована") Тогда
		ПоказатьПредупреждение(Неопределено, "Оформить поступление можно только по согласованной заявке. Текущее состояние: "
			+ Строка(Объект.Состояние) + ".");
		Возврат;
	КонецЕсли;

	ОткрытьФорму("Документ.ПоступлениеМатериалов.ФормаОбъекта",
		Новый Структура("Основание", Объект.Ссылка), , Новый УникальныйИдентификатор);
КонецПроцедуры

// Несохранённые правки записываем обычной записью формы: она выполняет
// проверку заполнения и подсвечивает ошибочные поля и строки.
&НаКлиенте
Функция ЗаписатьЕслиИзменена()
	Если Модифицированность ИЛИ Объект.Ссылка.Пустая() Тогда
		Возврат Записать();
	КонецЕсли;

	Возврат Истина;
КонецФункции

// Меняет состояние записанной заявки и сразу записывает её. Данные формы
// методом Записать() не обладают, поэтому работаем с объектом документа.
// Программная запись проверку заполнения не выполняет, поэтому при
// необходимости вызываем её явно.
&НаСервере
Функция ЗаписатьСНовымСостоянием(НовоеСостояние, ПроверятьЗаполнение)
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.Состояние = НовоеСостояние;

	Если ПроверятьЗаполнение И НЕ ДокументОбъект.ПроверитьЗаполнение() Тогда
		Возврат "Заявка заполнена с ошибками, состояние не изменено.";
	КонецЕсли;

	Попытка
		ДокументОбъект.Записать();
	Исключение
		Возврат "Ошибка при записи: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	Модифицированность = Ложь;

	Возврат "";
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатСменыСостояния(ПричинаОтказа)
	Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
		ПоказатьПредупреждение(Неопределено, ПричинаОтказа);
	Иначе
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры
