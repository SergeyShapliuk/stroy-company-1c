&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаМатериала)
	СтрокаМатериала.Сумма = УчебныеФункции.РассчитатьСумму(СтрокаМатериала.Количество, СтрокаМатериала.Цена);
КонецПроцедуры    

&НаКлиенте
Процедура ПересчитатьИтогПоЗаявке()
	Итог = 0;

	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл
		Итог = Итог + СтрокаМатериала.Сумма;
	КонецЦикла;

	ИтогоПоЗаявке = Итог;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
    СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;
	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;
	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЦенаМатериала(Материал)
	Возврат Материал.Цена;
КонецФункции

&НаКлиенте
Процедура МатериалыМатериалПриИзменении(Элемент)
СтрокаМатериала = Элементы.Материалы.ТекущиеДанные;

	Если ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
		СтрокаМатериала.Цена = ЦенаМатериала(СтрокаМатериала.Материал);
	Иначе
		СтрокаМатериала.Цена = 0;
	КонецЕсли;

	ПересчитатьСуммуСтроки(СтрокаМатериала);
	ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
ПересчитатьИтогПоЗаявке();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЗаявку(Команда)
	Сводка = ПересчитатьЗаявкуНаСервере();

	ИтогоПоЗаявке = Сводка.Итого;

	Сообщить("Строк в заявке: " + Строка(Сводка.ВсегоСтрок) + ", итого: " + Строка(Сводка.Итого));

	Если Сводка.СтрокБезМатериала > 0 Тогда
		Сообщить("Строк без выбранного материала: " + Строка(Сводка.СтрокБезМатериала) + ". Такую заявку записать не получится.");
	КонецЕсли;	
КонецПроцедуры    

&НаСервере
Функция ПересчитатьЗаявкуНаСервере()

	Сводка = Новый Структура("ВсегоСтрок, СтрокБезМатериала, Итого", 0, 0, 0);

	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл

		СтрокаМатериала.Сумма = УчебныеФункции.РассчитатьСумму(СтрокаМатериала.Количество, СтрокаМатериала.Цена);

		Сводка.ВсегоСтрок = Сводка.ВсегоСтрок + 1;
		Сводка.Итого = Сводка.Итого + СтрокаМатериала.Сумма;

		Если Не ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			Сводка.СтрокБезМатериала = Сводка.СтрокБезМатериала + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Сводка;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Сообщить(Строка(Объект.Состояние));
	Если Объект.Ссылка.Пустая() Тогда
		Объект.Состояние = Перечисления.СостоянияЗаявок.Новая;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Согласовать(Команда)
	ПричинаОтказа = СогласоватьНаСервере();

	Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
		ПоказатьПредупреждение(Неопределено, ПричинаОтказа);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СогласоватьНаСервере()
    Если Объект.Состояние <> Перечисления.СостоянияЗаявок.Новая Тогда
        Возврат "Согласовать можно только новую заявку.";
    КонецЕсли;

    Если Объект.Материалы.Количество() = 0 Тогда
        Возврат "В заявке нет ни одной строки материалов.";
    КонецЕсли;
    
    // Дополнительно проверяем строки перед согласованием!
    Отказ = Ложь;
	//Объект.ПроверитьСтрокиТабличнойЧасти(Отказ); // Вызов нашей новой процедуры
    Если Отказ Тогда
        Возврат "В заявке есть незаполненные строки. Согласование невозможно.";
    КонецЕсли;

    Объект.Состояние = Перечисления.СостоянияЗаявок.Согласована;
    
    // ОБЯЗАТЕЛЬНО ЗАПИСЫВАЕМ ОБЪЕКТ!
    Попытка
        Объект.Записать();
    Исключение
        Возврат "Ошибка при записи: " + ОписаниеОшибки();
    КонецПопытки;
    
    Возврат "";
КонецФункции

&НаКлиенте
Процедура Отклонить(Команда)
	ПричинаОтказа = ОтклонитьНаСервере();

	Если ЗначениеЗаполнено(ПричинаОтказа) Тогда
		ПоказатьПредупреждение(Неопределено, ПричинаОтказа);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОтклонитьНаСервере()
	Если Объект.Состояние = Перечисления.СостоянияЗаявок.Отклонена Тогда
		Возврат "Заявка уже отклонена.";
	КонецЕсли;

	Объект.Состояние = Перечисления.СостоянияЗаявок.Отклонена;
	Возврат "";
КонецФункции