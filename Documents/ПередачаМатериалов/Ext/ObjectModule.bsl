Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Склад и ОбъектСтроительства проверяет платформа по свойству «Проверка заполнения».
	// Объект строительства не измерение регистра, но выдача без получателя бессмысленна.

	Если Материалы.Количество() = 0 Тогда
		СообщитьОбОшибке("В передаче нет ни одной строки материалов", "Материалы");
		Отказ = Истина;
	КонецЕсли;

	ПроверитьСтрокиТабличнойЧасти(Отказ);

КонецПроцедуры

Процедура ПроверитьСтрокиТабличнойЧасти(Отказ)

	// Проверяем все строки за один проход, чтобы пользователь
	// увидел сразу все ошибки, а не по одной за нажатие
	Для Каждого СтрокаМатериала Из Материалы Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаМатериала.Материал) Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Материал", "не выбран материал");
			Отказ = Истина;
		КонецЕсли;

		Если СтрокаМатериала.Количество <= 0 Тогда
			СообщитьОбОшибкеСтроки(СтрокаМатериала.НомерСтроки, "Количество", "количество должно быть больше нуля");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОбОшибкеСтроки(НомерСтроки, ИмяРеквизита, ТекстОшибки)

	// ЧГ=0 — без разделителя тысяч, иначе путь «Материалы[1 000]» не найдёт ячейку;
	// ЧН=0 — чтобы нулевой индекс первой строки не превратился в пустую строку
	СообщитьОбОшибке("Строка " + Формат(НомерСтроки, "ЧГ=0") + ": " + ТекстОшибки,
		"Материалы[" + Формат(НомерСтроки - 1, "ЧН=0; ЧГ=0") + "]." + ИмяРеквизита);

КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстОшибки, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Все проверки — в ОбработкаПроверкиЗаполнения и свойствах «Проверка заполнения».
	// При интерактивном проведении платформа уже выполнила их, повторный вызов ничего не сообщит;
	// при программном (Записать(РежимЗаписиДокумента.Проведение)) — не вызывала.
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// Набор записей будет записан после выхода из процедуры,
	// заменив прежние движения этого документа
	Движения.ОстаткиМатериалов.Записывать = Истина;

	Для Каждого СтрокаМатериалов Из Материалы Цикл

		Движение = Движения.ОстаткиМатериалов.Добавить();

		// Вид движения — смысл операции, а не знак числа.
		// Количество всегда положительное
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Материал = СтрокаМатериалов.Материал;
		Движение.Склад = Склад;
		Движение.Количество = СтрокаМатериалов.Количество;

	КонецЦикла;

	// Контроль остатков — только при оперативном проведении.
	Если РежимПроведения <> РежимПроведенияДокумента.Оперативный Тогда
		Возврат;
	КонецЕсли;

	// Движения записываются заранее, остатки по их измерениям блокируются
	// до конца транзакции проведения.
	Движения.ОстаткиМатериалов.БлокироватьДляИзменения = Истина;
	Движения.Записать();

	ПроверитьОстаткиМатериалов(Отказ);

КонецПроцедуры

Процедура ПроверитьОстаткиМатериалов(Отказ)

	// Вызывается только при оперативном проведении, поэтому проверяем текущий
	// остаток без периода: он учитывает и движения документов более поздних дат.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПРЕДСТАВЛЕНИЕ(Остатки.Материал) КАК Материал,
		|	Остатки.КоличествоОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(
		|			,
		|			Склад = &Склад
		|				И Материал В (&Материалы)) КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток < 0";

	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Материалы", Материалы.ВыгрузитьКолонку("Материал"));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		СообщитьОбОшибке("Не хватает материала «" + Выборка.Материал + "» на складе «" + Склад
			+ "»: недостаёт " + Формат(-Выборка.Остаток, "ЧГ=0"), "Материалы");
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры
