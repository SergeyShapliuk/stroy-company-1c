
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьВидимостьЭлементов();
КонецПроцедуры

// Команда открывает отчёт кодом, поэтому платформа сама её не скрывает.
&НаСервере
Процедура УстановитьВидимостьЭлементов()
	Элементы.ФормаОстаткиСклада.Видимость = ПравоДоступа("Просмотр", Метаданные.Отчеты.ОстаткиНаСкладах);
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиСклада(Команда)
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
		Сообщить("Сначала выберите склад передачи");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Склад", Объект.Склад));
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);

	// Новый ключ уникальности: иначе повторное нажатие активирует уже открытый
	// из этой передачи отчёт, и новые Отбор и СформироватьПриОткрытии не применяются.
	ОткрытьФорму("Отчет.ОстаткиНаСкладах.Форма", ПараметрыФормы, ЭтаФорма, Новый УникальныйИдентификатор);
КонецПроцедуры
