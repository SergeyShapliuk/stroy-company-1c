// Справка снабженца по объекту строительства: по одной строке на материал
// рабочих заявок объекта (не помеченных на удаление и не отклонённых).
// Возвращает таблицу значений с колонками Материал, Заказано, Поступило,
// ОсталосьПолучить, Выдано, НаСкладах. Нет рабочих заявок — таблица пустая.
// Поступления берутся только по рабочим заявкам, иначе поступившее по
// удалённой заявке уводило бы «осталось получить» в минус.
//
// Каждая временная таблица сгруппирована до материала до соединения,
// иначе две строки одного материала в заявке или два поступления по ней
// размножили бы строки и удвоили числа.
Функция СправкаПоОбъекту(ОбъектСтроительства) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаявкаМатериалы.Материал КАК Материал,
		|	СУММА(ЗаявкаМатериалы.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Заказано
		|ИЗ
		|	Документ.ЗаявкаНаМатериалы.Материалы КАК ЗаявкаМатериалы
		|ГДЕ
		|	ЗаявкаМатериалы.Ссылка.ОбъектСтроительства = &ОбъектСтроительства
		|	И НЕ ЗаявкаМатериалы.Ссылка.ПометкаУдаления
		|	И ЗаявкаМатериалы.Ссылка.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявок.Отклонена)
		|СГРУППИРОВАТЬ ПО
		|	ЗаявкаМатериалы.Материал
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Материал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоступлениеМатериалы.Материал КАК Материал,
		|	СУММА(ПоступлениеМатериалы.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Поступило
		|ИЗ
		|	Документ.ПоступлениеМатериалов.Материалы КАК ПоступлениеМатериалы
		|ГДЕ
		|	ПоступлениеМатериалы.Ссылка.Проведен
		|	И ПоступлениеМатериалы.Ссылка.ДокументОснование.ОбъектСтроительства = &ОбъектСтроительства
		|	И НЕ ПоступлениеМатериалы.Ссылка.ДокументОснование.ПометкаУдаления
		|	И ПоступлениеМатериалы.Ссылка.ДокументОснование.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияЗаявок.Отклонена)
		|СГРУППИРОВАТЬ ПО
		|	ПоступлениеМатериалы.Материал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПередачаМатериалы.Материал КАК Материал,
		|	СУММА(ПередачаМатериалы.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТ_Выдано
		|ИЗ
		|	Документ.ПередачаМатериалов.Материалы КАК ПередачаМатериалы
		|ГДЕ
		|	ПередачаМатериалы.Ссылка.Проведен
		|	И ПередачаМатериалы.Ссылка.ОбъектСтроительства = &ОбъектСтроительства
		|СГРУППИРОВАТЬ ПО
		|	ПередачаМатериалы.Материал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.Материал КАК Материал,
		|	СУММА(Остатки.КоличествоОстаток) КАК Количество
		|ПОМЕСТИТЬ ВТ_НаСкладах
		|ИЗ
		|	РегистрНакопления.ОстаткиМатериалов.Остатки(
		|			,
		|			Материал В
		|				(ВЫБРАТЬ
		|					Заказано.Материал КАК Материал
		|				ИЗ
		|					ВТ_Заказано КАК Заказано)) КАК Остатки
		|СГРУППИРОВАТЬ ПО
		|	Остатки.Материал
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Заказано.Материал КАК Материал,
		|	Заказано.Количество КАК Заказано,
		|	ЕСТЬNULL(Поступило.Количество, 0) КАК Поступило,
		|	Заказано.Количество - ЕСТЬNULL(Поступило.Количество, 0) КАК ОсталосьПолучить,
		|	ЕСТЬNULL(Выдано.Количество, 0) КАК Выдано,
		|	ЕСТЬNULL(НаСкладах.Количество, 0) КАК НаСкладах
		|ИЗ
		|	ВТ_Заказано КАК Заказано
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Поступило КАК Поступило
		|		ПО (Поступило.Материал = Заказано.Материал)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Выдано КАК Выдано
		|		ПО (Выдано.Материал = Заказано.Материал)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НаСкладах КАК НаСкладах
		|		ПО (НаСкладах.Материал = Заказано.Материал)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Заказано.Материал.Наименование";

	Запрос.УстановитьПараметр("ОбъектСтроительства", ОбъектСтроительства);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
