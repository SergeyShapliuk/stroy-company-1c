Функция СобратьСтатистику() Экспорт
	Статистика = Новый Структура;
	Статистика.Вставить("Всего", 0);
	Статистика.Вставить("БезАртикула", 0);
	Статистика.Вставить("БезЕдиницы", 0);
	Статистика.Вставить("БезЦены", 0);

	Выборка = Справочники.Товары.Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		Статистика.Всего = Статистика.Всего + 1;

		Если НЕ ЗначениеЗаполнено(СокрЛП(Выборка.Артикул)) Тогда
			Статистика.БезАртикула = Статистика.БезАртикула + 1;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СокрЛП(Выборка.ЕдиницаИзмерения)) Тогда
			Статистика.БезЕдиницы = Статистика.БезЕдиницы + 1;
		КонецЕсли;

		Отбор = Новый Структура("Материал", Выборка.Ссылка);
		Если РегистрыСведений.ЦеныМатериалов.ПолучитьПоследнее(ТекущаяДата(), Отбор).Цена = 0 Тогда
			Статистика.БезЦены = Статистика.БезЦены + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Статистика;
КонецФункции

Функция НормализоватьТовары() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Обработано", 0);
	Результат.Вставить("Изменено", 0);
	Результат.Вставить("Ошибок", 0);

	Выборка = Справочники.Товары.Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		Результат.Обработано = Результат.Обработано + 1;

		НовыйАртикул = ВРег(СокрЛП(Выборка.Артикул));

		НоваяЕдиница = СокрЛП(Выборка.ЕдиницаИзмерения);
		Если НЕ ЗначениеЗаполнено(НоваяЕдиница) Тогда
			НоваяЕдиница = "шт.";
		КонецЕсли;

		Если НовыйАртикул = Выборка.Артикул И НоваяЕдиница = Выборка.ЕдиницаИзмерения Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.Артикул = НовыйАртикул;
			Объект.ЕдиницаИзмерения = НоваяЕдиница;
			Объект.Записать();
			Результат.Изменено = Результат.Изменено + 1;
		Исключение
			Результат.Ошибок = Результат.Ошибок + 1;
			Сообщить("Не удалось записать «" + Выборка.Наименование + "»: " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СоздатьТоварЕслиНет(Наименование, Артикул, Цена) Экспорт
	Если НЕ ЗначениеЗаполнено(СокрЛП(Наименование)) Тогда
		ВызватьИсключение "Не указано наименование товара";
	КонецЕсли;

	Товар = Справочники.Товары.НайтиПоНаименованию(СокрЛП(Наименование), Истина);
	Если Товар <> Справочники.Товары.ПустаяСсылка() Тогда
		Возврат Товар;
	КонецЕсли;

	НовыйТовар = Справочники.Товары.СоздатьЭлемент();
	НовыйТовар.Наименование = СокрЛП(Наименование);
	НовыйТовар.Артикул = Артикул;
	НовыйТовар.Записать();

	Если ЗначениеЗаполнено(Цена) Тогда
		ЗаписьЦены = РегистрыСведений.ЦеныМатериалов.СоздатьМенеджерЗаписи();
		ЗаписьЦены.Период = ТекущаяДата();
		ЗаписьЦены.Материал = НовыйТовар.Ссылка;
		ЗаписьЦены.Цена = Цена;
		ЗаписьЦены.Записать();
	КонецЕсли;

	Возврат НовыйТовар.Ссылка;
КонецФункции