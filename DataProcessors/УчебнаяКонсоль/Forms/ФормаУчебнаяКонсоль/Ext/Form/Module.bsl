	КонецЕсли;
	
	// Переименовали Объект → ОбъектТовара
	ОбъектТовара = Товар.ПолучитьОбъект();
	
	Сообщить("Тип ссылки: " + Строка(ТипЗнч(Товар)));
	Сообщить("Тип объекта: " + Строка(ТипЗнч(ОбъектТовара)));
	
	Сообщить("Артикул по ссылке: " + Товар.Артикул);
	Сообщить("Артикул по объекту: " + ОбъектТовара.Артикул);
	
