 
&НаКлиенте
Процедура Запустить(Команда)    
	Перем Количество;
	Перем Цена;
	Перем Сумма;
	Перем СуммаЗаказа;
	Перем Процент; 
	
	Если Ложь Тогда
		
		Количество = 20;
		Цена = 12.5;
		Сумма = Количество * Цена;
		
		Сообщить("Количество: " + Строка(Количество));
		Сообщить("Цена: " + Строка(Цена));
		Сообщить("Сумма: " + Строка(Сумма)); 
		Сообщить(Строка(ТипЗнч(250)));      
		
		ЦенаТекстом = "12.5";       
		
		Артикул1 = " цем-500 ";
		Артикул2 = "ЦЕМ-500";
		
		Сообщить("Как ввели: [" + Артикул1 + "] и [" + Артикул2 + "]");
		Сообщить("Совпадают до нормализации: " + Строка(Артикул1 = Артикул2));
		
		Ключ1 = ВРег(СокрЛП(Артикул1));
		Ключ2 = ВРег(СокрЛП(Артикул2));
		
		Сообщить("Совпадают после нормализации: " + Строка(Ключ1 = Ключ2));
		
		Сообщить("Уже в нужном виде: " + Строка(Число(ЦенаТекстом) * 2));
		
		ВводПользователя = "  12,5  ";
		Нормализованная = СокрЛП(ВводПользователя);                  // убрали пробелы по краям
		Нормализованная = СтрЗаменить(Нормализованная, ",", ".");    // привели разделитель
		Сообщить("После нормализации: " + Строка(Число(Нормализованная) * 2));
		
		Сообщить(Строка(ТипЗнч("Цемент М500")));
		Сообщить(Строка(ТипЗнч('20260101')));
		Сообщить(Строка(ТипЗнч(Истина)));
		Сообщить(Строка(ТипЗнч(Неопределено)));
		Сообщить(Строка(ТипЗнч(ПредопределенноеЗначение("Перечисление.ВидыКлиентов.Заказчик"))));
		
		Значение = "250";
		
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Сообщить("Это число, можно считать: " + Строка(Значение * 2));
		КонецЕсли; 
		
		Сообщить("Пустая строка: " + Строка(ЗначениеЗаполнено("")));
		Сообщить("Ноль: " + Строка(ЗначениеЗаполнено(0)));
		Сообщить("Пустая дата: " + Строка(ЗначениеЗаполнено('00010101')));
		Сообщить("Заполненная строка: " + Строка(ЗначениеЗаполнено("Центральный склад")));
		
		
		СуммаЗаказа = 32000;
		Если СуммаЗаказа<1000 Тогда
			Процент=0
		ИначеЕсли СуммаЗаказа < 5000 Тогда
			Процент=5
		Иначе 
			Процент=10
		КонецЕсли;
		
		Сообщить("Сумма заказа:" + Строка(СуммаЗаказа));
		Сообщить("Скидка:" + Строка(Процент) + "%");
		Сообщить("К оплате:" + Строка(СуммаЗаказа - СуммаЗаказа * Процент/100));
		
		Количество = 1500;
		
		Если Количество >= 1 И Количество <= 1000 Тогда
			Сообщить("Количество принято: " + Строка(Количество));
		Иначе
			Сообщить("Недопустимое количество: " + Строка(Количество) + ". Допустимо от 1 до 1000.");
		КонецЕсли;
		
		Единица = "";
		Единица = ?(ЗначениеЗаполнено(Единица), Единица, "шт.");
		Сообщить("Единица измерения: " + Единица);   
		
		//ВидКлиента = Перечисления.ВидыКлиентов.Поставщик;
		
		//Если ВидКлиента = Перечисления.ВидыКлиентов.Заказчик Тогда
		//	Сообщить("Заказчик: оформляем заявку на материалы");
		//ИначеЕсли ВидКлиента = Перечисления.ВидыКлиентов.Поставщик Тогда
		//	Сообщить("Поставщик: запрашиваем прайс и сроки");
		//ИначеЕсли ВидКлиента = Перечисления.ВидыКлиентов.Подрядчик Тогда
		//	Сообщить("Подрядчик: согласуем объём работ");
		//Иначе
		//	Сообщить("Вид клиента не определён");
		//КонецЕсли;
		ВидКлиента = ПредопределенноеЗначение("Перечисление.ВидыКлиентов.Поставщик");
		
		Если ВидКлиента = ПредопределенноеЗначение("Перечисление.ВидыКлиентов.Заказчик") Тогда
			Сообщить("Заказчик: оформляем заявку на материалы");
		ИначеЕсли ВидКлиента = ПредопределенноеЗначение("Перечисление.ВидыКлиентов.Поставщик") Тогда
			Сообщить("Поставщик: запрашиваем прайс и сроки");
		ИначеЕсли ВидКлиента = ПредопределенноеЗначение("Перечисление.ВидыКлиентов.Подрядчик") Тогда
			Сообщить("Подрядчик: согласуем объём работ");
		Иначе
			Сообщить("Вид клиента не определён");
		КонецЕсли;	  
		Количество = 20;
		Цена = 0;
		
		Если НЕ ЗначениеЗаполнено(Цена) Тогда
			Сообщить("Цена не заполнена — расчёт не выполнен");
		Иначе
			Сообщить("Сумма: " + Строка(Количество * Цена));
		КонецЕсли;      
		Количество = 20;
		Цена = 0;
		
		// Правильно: «ни количество, ни цена не равны нулю»
		Если НЕ (Количество = 0 ИЛИ Цена = 0) Тогда
			Сообщить("Со скобками: данные заполнены");
		Иначе
			Сообщить("Со скобками: чего-то не хватает");
		КонецЕсли;
		
		// Те же слова без скобок — платформа читает это иначе
		Если НЕ Количество = 0 ИЛИ Цена = 0 Тогда
			Сообщить("Без скобок: данные заполнены");
		Иначе
			Сообщить("Без скобок: чего-то не хватает");
		КонецЕсли;   
		
		Для Счетчик=1 По 10 Цикл
			Сообщить("7 х " + Строка(Счетчик) + "=" + Строка(7 * Счетчик));
		КонецЦикла;     
		
		Значение = 1;
		Пока Значение < 1000 Цикл
			Значение = Значение * 2;
			Сообщить(Значение)
		КонецЦикла;
		
		Для Счётчик = 1 По 20 Цикл
			Если Цел(Счётчик / 2) * 2 <> Счётчик Тогда
				Продолжить;  // нечётное — пропускаем
			КонецЕсли;
			Сообщить(Строка(Счётчик));
		КонецЦикла;
		
		
	КонецЕсли;    
	Сообщить("Сумма: " + Строка(УчебныеФункции.РассчитатьСумму(20, 12.5)));
	Сообщить("Со ставкой 10: " + Строка(УчебныеФункции.РассчитатьСуммуСНДС(1000, 10)));
	Сообщить("Без указания ставки: " + Строка(УчебныеФункции.РассчитатьСуммуСНДС(1000)));
	
	ВывестиИтог("Количество", 20);
	ВывестиИтог("Цена", 12.5);
	ВывестиИтог("Сумма", УчебныеФункции.РассчитатьСумму(20, 12.5));     
	
	Сообщить(УчебныеФункцииКлиент.ОформитьСообщение("ЭтаФорма.Счётчи: ", ЭтаФорма.ИмяФормы));
	
	УвеличитьСчётчик();     
	
	Цена = ПолучитьЦенуТовара("Цемент М500");
	Сообщить(УчебныеФункцииКлиент.ОформитьСообщение("Цена цемента на сервере без контекста", Цена));
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Для Счётчик = 1 По 20 Цикл
		Цена = ПолучитьЦенуТовара("Цемент М500");
	КонецЦикла;
	
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
	Сообщить(УчебныеФункцииКлиент.ОформитьСообщение("Двадцать вызовов, мс", Длительность));
	
	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Товары = ПолучитьВсеТовары();
	Для Каждого Товар Из Товары Цикл
		Цена = Товар.Цена;
	КонецЦикла;
	
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
	Сообщить(УчебныеФункцииКлиент.ОформитьСообщение("Один вызов, мс", Длительность));
	ПоказатьПредупреждение(, "Получено товаров: " + Строка(Товары.Количество()));
	
	
	Материалы = ПолучитьМатериалыМассивом();
	Для Каждого Материал Из Материалы Цикл
		Сообщить(УчебныеФункцииКлиент.ОформитьСообщение(Материал.Наименование, Материал.Цена));
	КонецЦикла;
КонецПроцедуры      

&НаКлиенте
Процедура ВывестиИтог(Заголовок, Значение)
	Сообщить(Заголовок + ": " + Строка(Значение));
КонецПроцедуры         

&НаСервереБезКонтекста
Функция ПолучитьЦенуТовара(Наименование)       
	Товар = Справочники.Товары.НайтиПоНаименованию(Наименование);
	Если Товар = Справочники.Товары.ПустаяСсылка() Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ЦенаМатериала(Товар);
КонецФункции

// Цена — не реквизит справочника Товары, а запись регистра сведений ЦеныМатериалов.
// Действующая цена — последняя запись на текущую дату.
&НаСервереБезКонтекста
Функция ЦенаМатериала(Материал)
	Отбор = Новый Структура("Материал", Материал);
	Возврат РегистрыСведений.ЦеныМатериалов.ПолучитьПоследнее(ТекущаяДата(), Отбор).Цена;
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьЦенуМатериала(Материал, Цена)
	ЗаписьЦены = РегистрыСведений.ЦеныМатериалов.СоздатьМенеджерЗаписи();
	ЗаписьЦены.Период = ТекущаяДата();
	ЗаписьЦены.Материал = Материал;
	ЗаписьЦены.Цена = Цена;
	ЗаписьЦены.Записать();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВсеТовары()    
	
	Результат = Новый Массив;
	
	Выборка = Справочники.Товары.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Наименование", Выборка.Наименование);
		Элемент.Вставить("Цена", ЦенаМатериала(Выборка.Ссылка));
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УвеличитьСчётчик()
	
	// Счётчик — реквизит формы, он часть контекста формы.
	// Поэтому процедура видит его без параметра.
	Счётчик = Счётчик + 1;
	
КонецПроцедуры


