&НаСервере
Процедура ВывестиСправкуПоОбъекту(НаименованиеОбъекта)

	ОбъектСтроительства = Справочники.ОбъектыСтроительства.НайтиПоНаименованию(НаименованиеОбъекта, Истина);

	Если ОбъектСтроительства.Пустая() Тогда
		Сообщить("Объект строительства «" + НаименованиеОбъекта + "» не найден");
		Возврат;
	КонецЕсли;

	Справка = СправкиСнабженцаСервер.СправкаПоОбъекту(ОбъектСтроительства);

	Если Справка.Количество() = 0 Тогда
		Сообщить("У объекта «" + НаименованиеОбъекта + "» нет рабочих заявок");
		Возврат;
	КонецЕсли;

	Сообщить("Справка по объекту «" + НаименованиеОбъекта + "»:");

	Для Каждого СтрокаСправки Из Справка Цикл
		Сообщить("  " + СтрокаСправки.Материал + ": заказано " + СтрокаСправки.Заказано
			+ ", поступило " + СтрокаСправки.Поступило
			+ ", осталось получить " + СтрокаСправки.ОсталосьПолучить
			+ ", выдано на объект " + СтрокаСправки.Выдано
			+ ", на складах " + СтрокаСправки.НаСкладах);
	КонецЦикла;

КонецПроцедуры




