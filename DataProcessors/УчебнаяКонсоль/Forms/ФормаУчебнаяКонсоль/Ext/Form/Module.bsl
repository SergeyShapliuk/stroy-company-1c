	//ВывестиИсполнениеЗаявокТочно();
	//ВывестиИсполнениеПакетом();
    //ВывестиЦеныНаДату('20260915');
	//ВывестиЦеныНаДату('20261022');
	//ВывестиЦеныНаДату('20260815');    
	//ВывестиОстаткиСклада();
