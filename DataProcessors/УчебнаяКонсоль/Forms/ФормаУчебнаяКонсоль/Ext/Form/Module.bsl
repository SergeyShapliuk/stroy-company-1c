КонецПроцедуры

&НаКлиенте
Процедура ВывестиИтог(Заголовок, Значение)
	Сообщить(Заголовок + ": " + Строка(Значение));
КонецПроцедуры         

&НаСервереБезКонтекста
Функция ПолучитьЦенуТовара(Наименование)       
	Товар = Справочники.Товары.НайтиПоНаименованию(Наименование);
	Если Товар = Справочники.Товары.ПустаяСсылка() Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ЦенаМатериала(Товар);
КонецФункции

// Цена — не реквизит справочника Товары, а запись регистра сведений ЦеныМатериалов.
// Действующая цена — последняя запись на текущую дату.
&НаСервереБезКонтекста
Функция ЦенаМатериала(Материал)
	Отбор = Новый Структура("Материал", Материал);
	Возврат РегистрыСведений.ЦеныМатериалов.ПолучитьПоследнее(ТекущаяДата(), Отбор).Цена;
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьЦенуМатериала(Материал, Цена)
	ЗаписьЦены = РегистрыСведений.ЦеныМатериалов.СоздатьМенеджерЗаписи();
	ЗаписьЦены.Период = ТекущаяДата();
	ЗаписьЦены.Материал = Материал;
	ЗаписьЦены.Цена = Цена;
	ЗаписьЦены.Записать();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВсеТовары()    
	
	Результат = Новый Массив;
	
	Выборка = Справочники.Товары.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("Наименование", Выборка.Наименование);
		Элемент.Вставить("Цена", ЦенаМатериала(Выборка.Ссылка));
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УвеличитьСчётчик()
	
	// Счётчик — реквизит формы, он часть контекста формы.
	// Поэтому процедура видит его без параметра.
	Счётчик = Счётчик + 1;
	
КонецПроцедуры


