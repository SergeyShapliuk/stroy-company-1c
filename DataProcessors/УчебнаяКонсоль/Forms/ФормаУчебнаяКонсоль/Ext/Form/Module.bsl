&НаСервере
Функция СоздатьТоварЕслиНет(Наименование,Артикул, Цена) 
	Товар = Справочники.Товары.НайтиПоНаименованию(Наименование);
	Сообщить("Тип: " + Строка(ТипЗнч(Товар)));
	Если ЗначениеЗаполнено(Товар) Тогда
		Сообщить("Товар найден" + Строка(Наименование));
		Возврат "Return";		  
	КонецЕсли;    
	
	// СоздатьЭлемент() даёт объект в памяти. В базе его пока нет.
	НовыйТовар = Справочники.Товары.СоздатьЭлемент();
	НовыйТовар.Наименование = Наименование;
	НовыйТовар.Артикул = Артикул;
	НовыйТовар.ЕдиницаИзмерения = "шт.";

	// Вот здесь элемент появляется в базе
	НовыйТовар.Записать();

	// Цену пишем в регистр, когда у товара уже есть ссылка
	Если ЗначениеЗаполнено(Цена) Тогда
		УстановитьЦенуМатериала(НовыйТовар.Ссылка, Цена);
	КонецЕсли;

	Сообщить("Создан элемент: " + Наименование + ", код " + НовыйТовар.Код);
	
	Возврат НовыйТовар.Ссылка;
	
КонецФункции 

&НаСервере
Функция ИзменитьЦенуЦемента(Наименование) 
	Товар = Справочники.Товары.НайтиПоНаименованию(Наименование);
	Сообщить("Тип: " + Строка(ТипЗнч(Товар)));
	
	Если Не ЗначениеЗаполнено(Товар) Тогда
		Сообщить("Товар не найден" + Строка(Наименование));
		Возврат "Return";		  
	КонецЕсли;    
	
	// Объект товара не нужен: цена хранится в регистре сведений.
	// Новая цена — новая запись на сегодня, прежние цены остаются в истории.
	СтараяЦена = ЦенаМатериала(Товар);
	УстановитьЦенуМатериала(Товар, СтараяЦена * 1.1); // плюс 10 процентов

	Сообщить("Цена была: " + Строка(СтараяЦена));
	Сообщить("Цена стала: " + Строка(ЦенаМатериала(Товар)));
	
КонецФункции    

&НаСервере
Функция ЗаполнитьПустыеЕдиницы() 
	Выборка = Справочники.Товары.Выбрать();
	Изменено = 0;
	Проверено = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Проверено = Проверено + 1;
		
		// Если реквизит заполнен — ничего не делаем и объект не получаем.
		// Запись дорогая, и лишние записи ни к чему.
		Если ЗначениеЗаполнено(Выборка.ЕдиницаИзмерения) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектТовара = Выборка.Ссылка.ПолучитьОбъект();
		ОбъектТовара.ЕдиницаИзмерения = "шт.";
		ОбъектТовара.Записать();
		
		Изменено = Изменено + 1;
		Сообщить("Заполнена единица у: " + Выборка.Наименование);
		
	КонецЦикла;
	
	Сообщить("Проверено элементов: " + Строка(Проверено));
	Сообщить("Изменено элементов: " + Строка(Изменено));	
КонецФункции    

