&НаКлиенте
Процедура Проверить(Команда)
	Статистика = НормализацияСправочниковСервер.СобратьСтатистику();

	Если Статистика.Всего = 0 Тогда
		Сообщить("В справочнике «Товары» нет элементов — обрабатывать нечего");
		Возврат;
	КонецЕсли;

	Сообщить("Всего элементов: " + Строка(Статистика.Всего));
	Сообщить("Пустой артикул: " + Строка(Статистика.БезАртикула));
	Сообщить("Пустая единица измерения: " + Строка(Статистика.БезЕдиницы));
	Сообщить("Нет действующей цены: " + Строка(Статистика.БезЦены));
КонецПроцедуры

&НаКлиенте
Процедура Исправить(Команда)
	Результат = НормализацияСправочниковСервер.НормализоватьТовары();

	Если Результат.Обработано = 0 Тогда
		Сообщить("В справочнике «Товары» нет элементов — обрабатывать нечего");
		Возврат;
	КонецЕсли;

	Сообщить("Обработано элементов: " + Строка(Результат.Обработано));
	Сообщить("Изменено элементов: " + Строка(Результат.Изменено));

	Если Результат.Ошибок > 0 Тогда
		Сообщить("Не удалось изменить элементов: " + Строка(Результат.Ошибок));
	КонецЕсли;
КонецПроцедуры