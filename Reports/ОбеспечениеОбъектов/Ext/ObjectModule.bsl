// Отчёт не строится без объекта строительства (самостоятельная задача после занятия 79).
// Правила подсчёта, связи наборов и оформление живут в схеме компоновки;
// здесь только отказ, когда параметр ОбъектСтроительства не выбран или выключен.
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	ЗначениеОбъекта = КомпоновщикНастроек.ПолучитьНастройки().ПараметрыДанных.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("ОбъектСтроительства"));

	Если ЗначениеОбъекта <> Неопределено
		И ЗначениеОбъекта.Использование
		И ЗначениеЗаполнено(ЗначениеОбъекта.Значение) Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	ДокументРезультат.Очистить();
	Сообщить("Выберите объект строительства");

КонецПроцедуры
